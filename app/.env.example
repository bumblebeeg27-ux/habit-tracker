# Base URL of the FitCoach backend proxy (see ../server). For the iOS
# Simulator, localhost works since it shares the Mac's network; a physical
# device needs the Mac's LAN IP instead (e.g. http://192.168.1.23:4001).
EXPO_PUBLIC_API_URL=http://localhost:4001

# Must match APP_CLIENT_KEY in server/.env. This is a soft abuse-control
# value, not a secret -- it ships inside the app bundle and can be extracted,
# so never put anything sensitive here (see server/.env.example for why).
EXPO_PUBLIC_CLIENT_KEY=replace-with-the-servers-app-client-key
