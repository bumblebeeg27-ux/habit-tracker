PORT=4001

# Origin(s) allowed to call this API. Not used by the mobile app directly
# (Expo apps don't send a browser Origin header), kept for local web/testing.
CORS_ORIGIN=http://localhost:8081

# Anthropic API key, used server-side only. NEVER expose this to the mobile
# client (i.e. never prefix it EXPO_PUBLIC_ or ship it in the app bundle).
ANTHROPIC_API_KEY=replace-with-a-real-key

# Soft abuse control: the app sends this header on every request; requests
# without a match are rejected. This is NOT real authentication (the key
# ships inside the app bundle and can be extracted) -- just a cheap filter
# against drive-by scraping of the open proxy. Real per-user auth would be
# needed if this app ever adds accounts.
APP_CLIENT_KEY=replace-with-a-random-string
